@model StudentWithDeptListViewModel

<h1>Edit</h1>

<form method="post" action="/Student/SaveEdit/@Model.Id">

    <div>
        <label asp-for="Name">Student Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div>
        <label asp-for="Age">Student Age</label>
        <input asp-for="Age" class="form-control" />
    </div>

    <div>
        <label>Department</label>
        <select id="DepartmentId" name="DepartmentId" class="form-control">
            @foreach (var item in Model.Departments)
            {
                if (item.Id == Model.DepartmentId)
                {
                    <option value="@item.Id" selected>@item.Name</option>
                }
                else
                {
                    <option value="@item.Id">@item.Name</option>
                }
            }
        </select>
    </div>

    <input type="submit" value="Save Changes" class="btn btn-success mt-3" />

</form>

<a asp-action="ShowAll" asp-controller="Student">Back to List</a>