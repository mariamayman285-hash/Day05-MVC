@model Student
<h1>Delete</h1>
<h2>Are u sure you want to delete this?</h2>
<h3>@Model.Name</h3>
<h3>@Model.Age</h3>
<h3>@Model.DepartmentId</h3>

@* the answer *@
<form method="post" asp-action="ConfirmDelete" asp-controller="Student" asp-route-id="@Model.Id">
	<input type="submit" value="Delete" class="btn btn-danger" />
</form>

@* back to list option *@
<a asp-action="ShowAll" asp-controller="Student"> Back to List </a>